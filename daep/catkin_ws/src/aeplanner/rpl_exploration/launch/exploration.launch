<?xml version="1.0" ?>
<launch>
  
  <arg name="config_file" default="cafe_exploration.yaml" />
  <arg name="experiment_seed" default="-1" />
  <arg name="rrt_log_path" default="$(optenv RRT_TREE_LOG_PATH)" />
  <arg name="rrt_goal_log_path" default="$(optenv RRT_GOAL_LOG_PATH)" />
  <arg name="rrt_log_enabled" default="$(optenv RRT_TREE_LOG_ENABLED false)" />
  <arg name="rrt_log_every_n" default="$(optenv RRT_TREE_LOG_EVERY_N 1)" />

  <arg name="param_file" default="$(find rpl_exploration)/config/$(arg config_file)" />

  <group ns="aeplanner">
    <param name="experiment_seed" value="$(arg experiment_seed)" />
    <param name="daep/rrt/log_path" value="$(arg rrt_log_path)" />
    <param name="daep/rrt/goal_log_path" value="$(arg rrt_goal_log_path)" />
    <param name="daep/rrt/log_enabled" value="$(arg rrt_log_enabled)" />
    <param name="daep/rrt/log_every_n" value="$(arg rrt_log_every_n)" />

    <node pkg="tf2_ros" type="static_transform_publisher" name="primesense_broadcaster" args="0.05 0 0.13 -1.57079633 0 -1.57079633 base_link camera_link" />

    <include file="$(find aeplanner)/launch/aeplanner_nodelet.launch"/>
    <include file="$(find pigain)/launch/pig.launch"/>
    <include file="$(find pigain)/launch/dfm.launch"/>
    <include file="$(find rpl_exploration)/launch/octomap_server.launch"/>
    <include file="$(find rrtplanner)/launch/rrtplanner.launch"/>
    <include file="$(find aeplanner_evaluation)/launch/coverage_evaluation.launch"/>

    <node name="rpl_exploration" pkg="rpl_exploration" type="rpl_exploration" output="screen" />
    <rosparam command="load" file="$(arg param_file)" />
  </group>

</launch>
